// CodeSweep - Tools > Options (Unified Settings, interfaz moderna de VS 2026).
// Cada "path" de "migration" es la clave en el SettingsManager de VS que lee VsSettingsStore (SettingKeys.cs).
// Al cambiar este archivo, subir "CacheTag" en CodeSweep.Settings.pkgdef para que VS lo vuelva a leer.
{
  "properties": {
    // =============================================
    // General
    // =============================================
    "codeSweep.general.cleanupOnSave": {
      "type": "boolean",
      "title": "Automatic cleanup on save",
      "description": "Clean each document right before it is saved.",
      "default": false,
      "order": 0,
      "migration": { "pass": { "input": { "store": "SettingsManager", "path": "CodeSweep.General.CleanupOnSave" } } }
    },

    // =============================================
    // Cleanup Rules (C#)
    // =============================================
    "codeSweep.rules.removeUnusedLocalVariables": {
      "type": "boolean",
      "title": "Remove unused local variables",
      "description": "Removes locals reported as CS0168 / CS0219. Skipped when the file has compile errors.",
      "default": true,
      "order": 0,
      "migration": { "pass": { "input": { "store": "SettingsManager", "path": "CodeSweep.Rules.RemoveUnusedLocalVariables" } } }
    },
    "codeSweep.rules.removeUnusedUsings": {
      "type": "boolean",
      "title": "Remove unused usings",
      "description": "Removes using directives reported as CS8019. Skipped when the file has compile errors.",
      "default": true,
      "order": 1,
      "migration": { "pass": { "input": { "store": "SettingsManager", "path": "CodeSweep.Rules.RemoveUnusedUsings" } } }
    },
    "codeSweep.rules.sortUsings": {
      "type": "boolean",
      "title": "Sort usings",
      "description": "global → normal → static → alias; System.* first; then alphabetical.",
      "default": true,
      "order": 2,
      "migration": { "pass": { "input": { "store": "SettingsManager", "path": "CodeSweep.Rules.SortUsings" } } }
    },
    "codeSweep.rules.removeConsecutiveBlankLines": {
      "type": "boolean",
      "title": "Remove consecutive blank lines",
      "description": "Keeps at most one blank line in a row. Never touches strings or disabled code.",
      "default": true,
      "order": 3,
      "migration": { "pass": { "input": { "store": "SettingsManager", "path": "CodeSweep.Rules.RemoveConsecutiveBlankLines" } } }
    },
    "codeSweep.rules.formatDocument": {
      "type": "boolean",
      "title": "Format document",
      "description": "Roslyn formatting; respects your .editorconfig.",
      "default": true,
      "order": 4,
      "migration": { "pass": { "input": { "store": "SettingsManager", "path": "CodeSweep.Rules.FormatDocument" } } }
    },

    // =============================================
    // File Types
    // =============================================
    "codeSweep.fileTypes.includeCSharp": {
      "type": "boolean",
      "title": "C# (.cs)",
      "description": "Cleaned with Roslyn, in the background and in parallel.",
      "default": true,
      "order": 0,
      "migration": { "pass": { "input": { "store": "SettingsManager", "path": "CodeSweep.FileTypes.IncludeCSharp" } } }
    },
    "codeSweep.fileTypes.includeVisualBasic": {
      "type": "boolean",
      "title": "Visual Basic (.vb)",
      "description": "Cleaned with Roslyn (formatting only).",
      "default": true,
      "order": 1,
      "migration": { "pass": { "input": { "store": "SettingsManager", "path": "CodeSweep.FileTypes.IncludeVisualBasic" } } }
    },
    "codeSweep.fileTypes.includeWebForms": {
      "type": "boolean",
      "title": "Web Forms (.aspx, .ascx, .master, .asax)",
      "description": "Formatted with the Visual Studio editor.",
      "default": true,
      "order": 2,
      "migration": { "pass": { "input": { "store": "SettingsManager", "path": "CodeSweep.FileTypes.IncludeWebForms" } } }
    },
    "codeSweep.fileTypes.includeRazor": {
      "type": "boolean",
      "title": "Razor (.cshtml, .vbhtml, .razor)",
      "description": "Formatted with the Visual Studio editor.",
      "default": true,
      "order": 3,
      "migration": { "pass": { "input": { "store": "SettingsManager", "path": "CodeSweep.FileTypes.IncludeRazor" } } }
    },
    "codeSweep.fileTypes.includeHtml": {
      "type": "boolean",
      "title": "HTML (.html, .htm)",
      "description": "Formatted with the Visual Studio editor.",
      "default": true,
      "order": 4,
      "migration": { "pass": { "input": { "store": "SettingsManager", "path": "CodeSweep.FileTypes.IncludeHtml" } } }
    },
    "codeSweep.fileTypes.includeXmlConfig": {
      "type": "boolean",
      "title": "XML / Config (.xml, .config, .webinfo)",
      "description": "Formatted with the Visual Studio editor.",
      "default": true,
      "order": 5,
      "migration": { "pass": { "input": { "store": "SettingsManager", "path": "CodeSweep.FileTypes.IncludeXmlConfig" } } }
    },
    "codeSweep.fileTypes.includeXaml": {
      "type": "boolean",
      "title": "XAML (.xaml)",
      "description": "Formatted with the Visual Studio editor.",
      "default": true,
      "order": 6,
      "migration": { "pass": { "input": { "store": "SettingsManager", "path": "CodeSweep.FileTypes.IncludeXaml" } } }
    },
    "codeSweep.fileTypes.includeStyles": {
      "type": "boolean",
      "title": "Styles (.css, .less, .scss)",
      "description": "Formatted with the Visual Studio editor.",
      "default": true,
      "order": 7,
      "migration": { "pass": { "input": { "store": "SettingsManager", "path": "CodeSweep.FileTypes.IncludeStyles" } } }
    },
    "codeSweep.fileTypes.includeScripts": {
      "type": "boolean",
      "title": "Scripts (.js, .ts)",
      "description": "Formatted with the Visual Studio editor.",
      "default": true,
      "order": 8,
      "migration": { "pass": { "input": { "store": "SettingsManager", "path": "CodeSweep.FileTypes.IncludeScripts" } } }
    },
    "codeSweep.fileTypes.includeJson": {
      "type": "boolean",
      "title": "JSON (.json)",
      "description": "Formatted with the Visual Studio editor.",
      "default": true,
      "order": 9,
      "migration": { "pass": { "input": { "store": "SettingsManager", "path": "CodeSweep.FileTypes.IncludeJson" } } }
    },
    "codeSweep.fileTypes.additionalFileExtensions": {
      "type": "string",
      "title": "Additional file extensions",
      "description": "Extensions not covered by the groups above, formatted with the Visual Studio editor. Separate with ';' (e.g. .skin;.sitemap).",
      "default": "",
      "order": 10,
      "migration": { "pass": { "input": { "store": "SettingsManager", "path": "CodeSweep.FileTypes.AdditionalFileExtensions" } } }
    },
    "codeSweep.fileTypes.ignoreGeneratedCode": {
      "type": "boolean",
      "title": "Exclude generated code",
      "description": "Skips *.designer.cs, *.g.cs, files under obj\\ and files marked <auto-generated>.",
      "default": true,
      "order": 11,
      "migration": { "pass": { "input": { "store": "SettingsManager", "path": "CodeSweep.FileTypes.IgnoreGeneratedCode" } } }
    },
    "codeSweep.fileTypes.excludeT4GeneratedCode": {
      "type": "boolean",
      "title": "Exclude T4 generated code",
      "description": "Skips files that have a .tt template with the same name.",
      "default": true,
      "order": 12,
      "migration": { "pass": { "input": { "store": "SettingsManager", "path": "CodeSweep.FileTypes.ExcludeT4GeneratedCode" } } }
    },
    "codeSweep.fileTypes.excludePatterns": {
      "type": "string",
      "title": "Exclude paths (regular expressions)",
      "description": "Files whose full path matches any expression are skipped. Separate with ';'.",
      "default": "\\.Designer\\.cs$;\\.Designer\\.vb$;\\.resx$;\\.min\\.css$;\\.min\\.js$",
      "order": 13,
      "migration": { "pass": { "input": { "store": "SettingsManager", "path": "CodeSweep.FileTypes.ExcludePatterns" } } }
    },
    "codeSweep.fileTypes.regenerateWebFormsDesigner": {
      "type": "boolean",
      "title": "Regenerate Web Forms designer after formatting",
      "description": "After formatting .aspx/.ascx/.master files, regenerates their .designer.cs with 'Convert to Web Application' (Web Application projects only). Usually not needed: formatting does not change controls.",
      "default": false,
      "order": 14,
      "enableWhen": "${config:codeSweep.fileTypes.includeWebForms}=='true'",
      "migration": { "pass": { "input": { "store": "SettingsManager", "path": "CodeSweep.FileTypes.RegenerateWebFormsDesigner" } } }
    }
  },

  "categories": {
    "codeSweep": {
      "title": "CodeSweep"
    },
    "codeSweep.general": {
      "title": "General",
      "order": 0
    },
    "codeSweep.rules": {
      "title": "Cleanup Rules",
      "order": 1
    },
    "codeSweep.fileTypes": {
      "title": "File Types",
      "order": 2
    }
  }
}
