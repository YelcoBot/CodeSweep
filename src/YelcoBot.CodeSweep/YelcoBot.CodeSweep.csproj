<Project>

  <!-- Imports explícitos: los targets del VSSDK deben ir DESPUÉS de Sdk.targets (necesitan IntermediateOutputPath, etc.) -->
  <Import Project="Sdk.props" Sdk="Microsoft.NET.Sdk" />

  <PropertyGroup>
    <TargetFramework>net481</TargetFramework>
    <RootNamespace>YelcoBot.CodeSweep</RootNamespace>
    <AssemblyName>YelcoBot.CodeSweep</AssemblyName>
    <GeneratePkgDefFile>true</GeneratePkgDefFile>
    <IncludeAssemblyInVSIXContainer>true</IncludeAssemblyInVSIXContainer>
    <IncludeDebugSymbolsInVSIXContainer>true</IncludeDebugSymbolsInVSIXContainer>
    <IncludeDebugSymbolsInLocalVSIXDeployment>true</IncludeDebugSymbolsInLocalVSIXDeployment>
    <CopyBuildOutputToOutputDirectory>true</CopyBuildOutputToOutputDirectory>
    <CopyOutputSymbolsToOutputDirectory>true</CopyOutputSymbolsToOutputDirectory>
    <UseCodebase>true</UseCodebase>
  </PropertyGroup>

  <!--
    Versión local del VSIX: source.extension.vsixmanifest queda fijo en 1.0.0 (el pipeline pone la real al publicar).
    Para probar builds locales en VS / SSMS, crea version.local.props junto a este .csproj (ignorado por git):
      <Project><PropertyGroup><LocalVsixVersion>1.10.1</LocalVsixVersion></PropertyGroup></Project>
    y sube LocalVsixVersion en cada build que quieras instalar encima de la anterior. Sin ese archivo, sale 1.0.0.
  -->
  <Import Project="version.local.props" Condition="Exists('version.local.props')" />

  <ItemGroup>
    <ProjectReference Include="..\YelcoBot.CodeSweep.Domain\YelcoBot.CodeSweep.Domain.csproj" />
    <ProjectReference Include="..\YelcoBot.CodeSweep.Application\YelcoBot.CodeSweep.Application.csproj" />
    <ProjectReference Include="..\YelcoBot.CodeSweep.Infrastructure.Roslyn\YelcoBot.CodeSweep.Infrastructure.Roslyn.csproj" />
    <ProjectReference Include="..\YelcoBot.CodeSweep.Infrastructure.Sql\YelcoBot.CodeSweep.Infrastructure.Sql.csproj" />
    <ProjectReference Include="..\YelcoBot.CodeSweep.Infrastructure.VisualStudio\YelcoBot.CodeSweep.Infrastructure.VisualStudio.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Community.VisualStudio.Toolkit.17" />
    <PackageReference Include="Community.VisualStudio.Toolkit.DependencyInjection.Microsoft.17" />
    <PackageReference Include="Microsoft.VSSDK.BuildTools" PrivateAssets="all" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
  </ItemGroup>

  <ItemGroup>
    <None Include="source.extension.vsixmanifest">
      <SubType>Designer</SubType>
    </None>
    <VSCTCompile Include="CodeSweepPackage.vsct">
      <ResourceName>Menus.ctmenu</ResourceName>
    </VSCTCompile>
    <!-- Textos del paquete (inglés / español): títulos de Tools > Options ("@Clave;{guid}" en CodeSweep.registration.json) -->
    <EmbeddedResource Update="VSPackage.resx">
      <MergeWithCTO>true</MergeWithCTO>
      <LogicalName>VSPackage.resources</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Update="VSPackage.es.resx">
      <LogicalName>VSPackage.es.resources</LogicalName>
    </EmbeddedResource>
    <!-- Tools > Options moderno (Unified Settings) -->
    <Content Include="CodeSweep.registration.json">
      <IncludeInVSIX>true</IncludeInVSIX>
    </Content>
    <Content Include="CodeSweep.Settings.pkgdef">
      <IncludeInVSIX>true</IncludeInVSIX>
    </Content>
    <!-- Imágenes de la extensión (generadas desde assets\codesweep-emblem.svg): Icon 128x128 y PreviewImage 200x200 del manifiesto -->
    <Content Include="Resources\Icon.png">
      <IncludeInVSIX>true</IncludeInVSIX>
    </Content>
    <Content Include="Resources\PreviewImage.png">
      <IncludeInVSIX>true</IncludeInVSIX>
    </Content>
    <Content Include="Resources\CodeSweep.ico">
      <IncludeInVSIX>true</IncludeInVSIX>
    </Content>
  </ItemGroup>

  <!--
    Archivos extra en el VSIX:
    - LICENSE.txt (lo pide el manifiesto), generado desde el LICENSE del repo.
    - Microsoft.Extensions.DependencyInjection* y Microsoft.Bcl.AsyncInterfaces: el VSSDK los omite.
      Deben ser 10.0.10 = la versión que trae VS 2026 (devenv.exe.config redirige 0.0.0.0-10.0.0.10 a su copia).
      Una versión mayor carga dos copias del mismo tipo (MissingMethodException). En VS 2022 se usan estas.
    - SqlEngine\: el motor T-SQL (ScriptDOM + EditorConfig y sus dependencias). Corre en un AppDomain aparte con esa carpeta
      como base, así siempre usa este ScriptDOM (también en SSMS, que trae otro con la misma identidad 18.0.0.0).
  -->
  <Target Name="IncludeExtraFilesInVsix" AfterTargets="GetVsixSourceItems">
    <ItemGroup>
      <_SqlEngineFiles Include="..\YelcoBot.CodeSweep.SqlEngine\bin\$(Configuration)\net481\*.dll" />
      <_SqlEngineSatellites Include="..\YelcoBot.CodeSweep.SqlEngine\bin\$(Configuration)\net481\es\*.dll" />
    </ItemGroup>
    <Copy SourceFiles="..\..\LICENSE" DestinationFiles="$(IntermediateOutputPath)LICENSE.txt" SkipUnchangedFiles="true" />
    <ItemGroup>
      <VSIXSourceItem Include="$(IntermediateOutputPath)LICENSE.txt" />
      <VSIXSourceItem Include="$(OutDir)Microsoft.Extensions.DependencyInjection.dll" />
      <VSIXSourceItem Include="$(OutDir)Microsoft.Extensions.DependencyInjection.Abstractions.dll" />
      <VSIXSourceItem Include="$(OutDir)Microsoft.Bcl.AsyncInterfaces.dll" />
      <VSIXSourceItem Include="@(_SqlEngineFiles)" VSIXSubPath="SqlEngine" />
      <VSIXSourceItem Include="@(_SqlEngineSatellites)" VSIXSubPath="SqlEngine\es" />
    </ItemGroup>
    <!-- Las dependencias del motor solo van en SqlEngine\: en la raíz las arrastra la referencia al proyecto, y ahí sobran. -->
    <ItemGroup>
      <_RootSqlEngineLeak Include="@(VSIXSourceItem)" Condition="'%(VSIXSourceItem.VSIXSubPath)' == '' And ('%(Filename)' == 'Microsoft.SqlServer.TransactSql.ScriptDom' Or '%(Filename)' == 'EditorConfig.Core' Or '%(Filename)' == 'System.IO.Abstractions' Or '%(Filename)' == 'TestableIO.System.IO.Abstractions' Or '%(Filename)' == 'TestableIO.System.IO.Abstractions.Wrappers' Or '%(Filename)' == 'Testably.Abstractions.FileSystem.Interface' Or '%(Filename)' == 'System.Numerics.Vectors')" />
      <VSIXSourceItem Remove="@(_RootSqlEngineLeak)" />
    </ItemGroup>
  </Target>

  <!-- Aplica LocalVsixVersion al manifiesto que va dentro del VSIX (obj\), nunca al source.extension.vsixmanifest del repo. -->
  <Target Name="ApplyLocalVsixVersion" AfterTargets="DetokenizeVsixManifestFile" Condition="'$(LocalVsixVersion)' != ''">
    <XmlPoke XmlInputPath="$(IntermediateVsixManifest)"
             Query="/x:PackageManifest/x:Metadata/x:Identity/@Version"
             Value="$(LocalVsixVersion)"
             Namespaces="&lt;Namespace Prefix='x' Uri='http://schemas.microsoft.com/developer/vsx-schema/2011' /&gt;" />
    <Message Importance="high" Text="CodeSweep: VSIX local con versión $(LocalVsixVersion) (version.local.props)." />
  </Target>

  <!-- Publicación al Marketplace: las usa el pipeline (no se empaquetan en el VSIX) -->
  <ItemGroup>
    <None Include="Marketplace\publishManifest.json" TargetPath="publishManifest.json" CopyToOutputDirectory="PreserveNewest" IncludeInVSIX="false" />
    <None Include="Marketplace\overview.md" TargetPath="overview.md" CopyToOutputDirectory="PreserveNewest" IncludeInVSIX="false" />
  </ItemGroup>

  <Import Project="Sdk.targets" Sdk="Microsoft.NET.Sdk" />

  <!-- Targets del VSSDK (vienen en Microsoft.VSSDK.BuildTools): sin esto no se genera el .vsix -->
  <Import Project="$(VSToolsPath)\VSSDK\Microsoft.VsSDK.targets" Condition="Exists('$(VSToolsPath)\VSSDK\Microsoft.VsSDK.targets')" />

</Project>
