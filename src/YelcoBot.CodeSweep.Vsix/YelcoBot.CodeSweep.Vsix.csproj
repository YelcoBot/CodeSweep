<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net481</TargetFramework>
    <RootNamespace>YelcoBot.CodeSweep.Vsix</RootNamespace>
    <AssemblyName>YelcoBot.CodeSweep.Vsix</AssemblyName>
    <GeneratePkgDefFile>true</GeneratePkgDefFile>
    <IncludeAssemblyInVSIXContainer>true</IncludeAssemblyInVSIXContainer>
    <IncludeDebugSymbolsInVSIXContainer>true</IncludeDebugSymbolsInVSIXContainer>
    <IncludeDebugSymbolsInLocalVSIXDeployment>true</IncludeDebugSymbolsInLocalVSIXDeployment>
    <CopyBuildOutputToOutputDirectory>true</CopyBuildOutputToOutputDirectory>
    <CopyOutputSymbolsToOutputDirectory>true</CopyOutputSymbolsToOutputDirectory>
    <UseCodebase>true</UseCodebase>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\YelcoBot.CodeSweep.Domain\YelcoBot.CodeSweep.Domain.csproj" />
    <ProjectReference Include="..\YelcoBot.CodeSweep.Application\YelcoBot.CodeSweep.Application.csproj" />
    <ProjectReference Include="..\YelcoBot.CodeSweep.Infrastructure.Roslyn\YelcoBot.CodeSweep.Infrastructure.Roslyn.csproj" />
    <ProjectReference Include="..\YelcoBot.CodeSweep.Infrastructure.VisualStudio\YelcoBot.CodeSweep.Infrastructure.VisualStudio.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Community.VisualStudio.Toolkit.17" />
    <PackageReference Include="Community.VisualStudio.Toolkit.DependencyInjection.Microsoft.17" />
    <PackageReference Include="Microsoft.VSSDK.BuildTools" PrivateAssets="all" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
  </ItemGroup>

  <ItemGroup>
    <None Include="source.extension.vsixmanifest">
      <SubType>Designer</SubType>
    </None>
    <VSCTCompile Include="CodeSweepPackage.vsct">
      <ResourceName>Menus.ctmenu</ResourceName>
    </VSCTCompile>
  </ItemGroup>

</Project>
